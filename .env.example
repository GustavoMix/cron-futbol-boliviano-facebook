# Facebook / Meta Graph API
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0

# X API v2
X_BEARER_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Opcional: escudos de equipo que ninguna otra fuente trae (TheSportsDB).
# Si se deja vacío usa la key pública de pruebas "3" (sin registro).
THESPORTSDB_API_KEY=

# Opcional: timeout de red
HTTP_TIMEOUT=25
